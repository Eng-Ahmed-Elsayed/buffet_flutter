{
  "//": "Copy to google-services.json and replace with the real values from the Firebase console (Project settings -> Your apps -> Android). Never commit the real file: dev and prod are different projects and a committed one guarantees the wrong build ships.",
  "project_info": {
    "project_number": "REPLACE_WITH_PROJECT_NUMBER",
    "project_id": "REPLACE_WITH_PROJECT_ID",
    "storage_bucket": "REPLACE_WITH_PROJECT_ID.firebasestorage.app"
  },
  "client": [
    {
      "client_info": {
        "mobilesdk_app_id": "REPLACE_WITH_MOBILESDK_APP_ID",
        "android_client_info": {
          "package_name": "com.defi.buffet_app"
        }
      },
      "oauth_client": [],
      "api_key": [{ "current_key": "REPLACE_WITH_API_KEY" }],
      "services": { "appinvite_service": { "other_platform_oauth_client": [] } }
    }
  ],
  "configuration_version": "1"
}
