<?xml version="1.0" encoding="utf-8"?>
<!--
  Adaptive icon for Android 8+. The launcher masks this to whatever shape the
  device uses (circle, squircle, teardrop), which is why the foreground layer
  keeps the mark well inside the safe zone rather than filling the frame.
-->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@color/ic_launcher_background"/>
    <foreground android:drawable="@mipmap/ic_launcher_foreground"/>
    <monochrome android:drawable="@mipmap/ic_launcher_monochrome"/>
</adaptive-icon>
